# Fixture env for the local/CI test instances (docker-compose.test.yml: PocketID + Postgres).
#
# !!! PUBLIC VALUES. Every secret below is published in this repository, so
# anyone can use it. Never copy this file, or any value in it, into a real
# deployment: a copied AUTH_SECRET lets anyone forge a session. The portal
# reports these values at startup when NODE_ENV=production.

APP_URL=http://localhost:1411
ENCRYPTION_KEY=3/ObGzLQoOHgG/3O0u9CY4B5Wo58DBL25vcnGjsGKh4=
STATIC_API_KEY=37ee7a71a924242acac68e6dc80896cfdf7136b08d58022c935ea6ffd1d3413e
ALLOW_USER_SIGNUPS=disabled
TRUST_PROXY=false

# Postgres (consumed by the postgres container itself).
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal-test-fixture
POSTGRES_DB=pocket_portal

# Consumed by test code (Vitest/Playwright), not by the containers themselves.
POCKETID_BASE_URL=http://localhost:1411
POCKETID_API_KEY=37ee7a71a924242acac68e6dc80896cfdf7136b08d58022c935ea6ffd1d3413e
DATABASE_URL=postgres://portal:portal-test-fixture@localhost:5432/pocket_portal

# Consumed by the Next.js app under test (NextAuth session JWT signing key).
# Fixed throwaway value, not a real secret — same rationale as STATIC_API_KEY above.
AUTH_SECRET=6f0a2f8e6e6a4f3f8b2b6f0e1d5c9a7b3e8f2c4a1d6b9e0f3a5c7d9b1e3f5a7c

# Bearer token for /api/metrics; unset means metrics are not served.
# Throwaway fixture like AUTH_SECRET above.
METRICS_TOKEN=e2e-metrics-token-0f3a5c7d9b1e3f5a7c

# POCKETID_OIDC_CLIENT_ID / POCKETID_OIDC_CLIENT_SECRET are NOT fixture values here:
# they're minted per test run by scripts/pocketid-provision-oidc-client.mjs
# (run as part of `npm run test-env:up`) into the gitignored .env.test.generated,
# because PocketID only returns a client secret once, at creation time.
