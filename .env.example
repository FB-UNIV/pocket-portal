# pocket-portal configuration contract.
#
# Copy to .env and fill in. docker-compose.yml reads this file
# automatically; the required values below fail fast with a named error if
# they are missing, rather than starting a half-configured portal.
#
# Summary table: README "Configuration". Non-secret settings can also go in
# a YAML file (CONFIG_FILE, below). In the image, any secret can come from a
# file instead: NAME_FILE=/run/secrets/name (e.g. POCKETID_API_KEY_FILE).

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Your PocketID instance. The portal is useless without one, and it is NOT
# started by the reference compose file.
POCKETID_BASE_URL=https://id.example.test

# Admin API key, used to read the OIDC client catalog, users and groups, and
# to perform group grants when an admin approves a request.
# NOTE: can also read PocketID's SMTP/LDAP passwords unless PocketID runs
# with UI_CONFIG_DISABLED=true. See README "Securing the portal".
POCKETID_API_KEY=

# The OIDC client the portal logs in with. Register it in PocketID with a
# callback URL of <your public origin>/api/auth/callback/pocketid.
POCKETID_OIDC_CLIENT_ID=
POCKETID_OIDC_CLIENT_SECRET=

# Signs the session cookie. Generate with: openssl rand -base64 32
# Must be IDENTICAL across replicas, or a cookie issued by one is rejected
# by another.
AUTH_SECRET=

# Database password used by both the portal and the bundled Postgres.
POSTGRES_PASSWORD=

# Image tag to deploy. Pinned on purpose: with a moving tag like `latest`, a
# restart can silently run different code, and rollback isn't reproducible.
# Bump it deliberately when you upgrade.
POCKET_PORTAL_TAG=v0.11.0

# ---------------------------------------------------------------------------
# Strongly recommended
# ---------------------------------------------------------------------------

# The portal's public origin, e.g. https://portal.example.test
#
# Leave it unset and Auth.js falls back to trusting the incoming Host
# header, which means a proxy forwarding an attacker-controlled Host can
# steer the OIDC callback. Setting this removes that dependency entirely.
# It must match the callback origin registered in PocketID.
# The portal logs a warning at startup if this is unset in production.
AUTH_URL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Where the reference compose publishes the portal. Loopback by default, on
# the assumption a TLS-terminating proxy sits in front.
#PORTAL_BIND=127.0.0.1
#PORTAL_PORT=3000

# Apply pending migrations on container start. Leave true for a plain
# `docker compose up`. Set false when a separate job runs
# `docker compose run --rm portal migrate` first.
#MIGRATE_ON_START=true

# Postgres user/database for the bundled service.
#POSTGRES_USER=portal
#POSTGRES_DB=pocket_portal

# Bearer token that unlocks /api/metrics for your Prometheus scraper.
# Unset means metrics are not served at all (every request gets a 404).
# Generate one with: openssl rand -hex 32
#METRICS_TOKEN=

# Access-request emails. Leave SMTP_HOST unset for none. The portal uses its
# own SMTP settings, not PocketID's. SMTP_TLS: starttls (default, port 587),
# tls (port 465) or none. With AUTH_URL set, emails link to the portal.
#SMTP_HOST=smtp.example.test
#SMTP_FROM=portal@example.test
#SMTP_PORT=587
#SMTP_TLS=starttls
#SMTP_USER=
#SMTP_PASSWORD=

# Feature flags, all on by default. Any set to a non-default value are
# listed in one startup log line.
#
# false: a plain launcher. /apps lists only what the user can open; pending
# requests can still be decided.
#FEATURE_ACCESS_REQUESTS=true
# The reason field on requests: optional, required or off.
#ACCESS_REQUEST_REASON=optional
# false: pause emails, keeping the SMTP settings.
#FEATURE_EMAIL_NOTIFICATIONS=true
# false: keep the portal's own look instead of PocketID's accent, name and
# logo.
#FEATURE_POCKETID_BRANDING=true
# The name shown in the header and page titles. Unset: the application name
# set in PocketID (unless it's still PocketID's default), else Pocket Portal.
#PORTAL_NAME=
# false: hide /admin/audit. Events are still recorded.
#FEATURE_AUDIT_LOG_PAGE=true
# false: hide the admin banner about readable PocketID secrets. The startup
# log still warns.
#WARN_POCKETID_SECRETS_READABLE=true

# Optional YAML file for the non-secret settings above; see
# pocket-portal.example.yaml. Variables set here still win. A file that is
# set but can't be read stops the portal.
#CONFIG_FILE=/etc/pocket-portal/config.yaml

# Log level: trace, debug, info, warn, error, fatal or silent. Anything else
# falls back to info, and is reported at startup.
#LOG_LEVEL=info

# OpenTelemetry. OTEL_EXPORTER_OTLP_ENDPOINT is read by the SDK itself.
#OTEL_SERVICE_NAME=pocket-portal
#OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.example.test:4318
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
